+// ════════════════════════════════════════════════════════════════════════════
+// PARTE 2 · con el dedo, en un teléfono
+// ════════════════════════════════════════════════════════════════════════════
+{
+  console.log('\nCON EL DEDO, EN UN TELÉFONO DE 360 px');
+  const ctx = await nav.newContext({ viewport: { width: 360, height: 780 }, locale: 'es-MX',
+    hasTouch: true, isMobile: true, deviceScaleFactor: 2 });
+  const p = await ctx.newPage();
+  const errs = []; p.on('pageerror', e => errs.push(e.message));
+  await montar(p, { calibrar: false });
+  await p.evaluate(() => {
+    SC.refLine = { nx1: 700 / 1200, ny1: 300 / 800, nx2: 700 / 1200, ny2: 700 / 800 };
+    SC.mode = 'ref-drawn';
+    document.getElementById('sc-ref-confirm-row').style.display = '';
+    scPintarRefRapidos();
+  });
+  await p.waitForTimeout(300);
+  await p.tap('#sc-ref-rapidos [role="radio"][data-v="200"]');
+  await p.waitForTimeout(250);
+  cierto(await p.evaluate(() => document.getElementById('sc-ref-cm-input').value === '200'),
+    'el dedo elige la puerta de 200 cm y el campo la recibe');
+  await p.tap('#sc-btn-confirm-calib');
+  await p.waitForTimeout(350);
+  cierto(await p.evaluate(() => SC.nativePxPerCm > 0), 'y «Confirmar escala» calibra con un toque');
+
+  /* El dedo de verdad sobre el lienzo, por el protocolo de Chrome: dos toques hacen una
+     medida, que es como se mide en el teléfono (arrastrar NO cierra la línea a propósito). */
+  const cdp = await ctx.newCDPSession(p);
+  const dedo = async (tipo, x, y) => {
+    await cdp.send('Input.dispatchTouchEvent', { type: tipo,
+      touchPoints: tipo === 'touchEnd' ? [] : [{ x, y, radiusX: 8, radiusY: 8, force: 1 }] });
+  };
+  const toque = async (x, y) => { await dedo('touchStart', x, y); await p.waitForTimeout(60); await dedo('touchEnd', x, y); await p.waitForTimeout(160); };
+  const a = await aPantalla(p, .15, .25), b = await aPantalla(p, .55, .25);
+  await toque(a.x, a.y);
+  const traPrimero = await p.evaluate(() => ({ armando: SC.building, pista: document.getElementById('sp-hint-bar').textContent }));
+  cierto(traPrimero.armando, 'el primer toque del dedo deja el punto puesto');
+  cierto(/Primer punto/.test(traPrimero.pista), 'y la pista lo dice: «' + traPrimero.pista.slice(0, 44).trim() + '»');
+  await toque(b.x, b.y);
+  await p.waitForTimeout(350);
+  cierto(await p.evaluate(() => SC.items.length === 1), 'el segundo toque cierra la medida');
+  cierto(await p.evaluate(() => !!document.querySelector('#sc-medidas-list .sp-mfila.lista-nueva')),
+    'y llega marcada a la lista, debajo del lienzo, que es donde no se notaba');
+
+  /* Y la lupa con el dedo: se arrastra sobre el lienzo y la cifra tiene que verse. */
+  await p.evaluate(() => scCancelarPunto());
+  await dedo('touchStart', a.x, a.y);
+  await p.waitForTimeout(80);
+  await dedo('touchMove', a.x + 40, a.y + 10);
+  await p.waitForTimeout(120);
+  const conDedo = await p.evaluate(() => {
+    const t = document.getElementById('sc-loupe-cifra');
+    return { lupa: document.getElementById('sc-loupe').style.display === 'block',
+      cifra: getComputedStyle(t).display !== 'none', texto: t.textContent.trim(),
+      dentro: t.getBoundingClientRect().right <= innerWidth + 1 && t.getBoundingClientRect().left >= -1 };
+  });
+  await dedo('touchEnd', a.x + 40, a.y + 10);
+  await p.waitForTimeout(150);
+  cierto(conDedo.lupa && conDedo.cifra, 'arrastrando con el dedo salen la lupa y su cifra');
+  cierto(conDedo.texto.length > 0, 'que dice algo: «' + conDedo.texto + '»');
+  cierto(conDedo.dentro, 'y la cifra no se sale de la pantalla aunque el dedo esté en el borde');
+
+  console.log('');
+  errs.length ? mal('errores de página con el dedo: ' + [...new Set(errs)].slice(0, 3).join(' | ')) : bien('cero errores de página con el dedo');
+  await ctx.close();
+}
