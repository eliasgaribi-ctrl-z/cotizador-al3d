+.ver-reng:last-child { border-bottom: 0; }
+.ver-reng.coincide { border-left-color: var(--ok); }
+.ver-reng.no-coincide { border-left-color: var(--mal); }
+.ver-valor { display: block; }
+
+/* El renglón marcado NO se atenúa. La propuesta de la ficha decía «atenúa el renglón», pero
+   el sistema de diseño prohíbe decir el estado con `opacity` sobre bloques con texto (§4.3):
+   un total al 60 % es justo el número que alguien está comparando con su papel a las siete de
+   la tarde. Lo que dice «ya lo revisé» es el filete verde de la izquierda y la palomita del
+   botón, las dos cosas legibles a plena luz y sin depender del color. */
+
+.ver-cotejo { display: flex; gap: var(--e2); margin-top: var(--e2); flex-wrap: wrap; }
+.ver-cot {
+  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
+  min-height: 44px; padding: 0 var(--e3);
+  font: inherit; font-size: var(--t2); font-weight: 600;
+  color: var(--tinta2); background: var(--sup);
+  border: 1px solid var(--linea); border-radius: var(--rr3);
+  cursor: pointer;
+  transition: background-color .15s ease, border-color .15s ease, color .15s ease, transform .16s var(--ease-out);
+}
+.ver-cot:active { transform: scale(.97); }
+@media (hover: hover) and (pointer: fine) { .ver-cot:hover { border-color: var(--a-borde); } }
+.ver-cot:focus-visible { outline: 2px solid var(--a); outline-offset: 2px; }
+.ver-cot-si[aria-pressed="true"] { color: var(--ok);  border-color: var(--ok-borde);  background: var(--ok-bg); }
+.ver-cot-no[aria-pressed="true"] { color: var(--mal); border-color: var(--mal-borde); background: var(--mal-bg); }
+/* La palomita de la pieza 6 vive aquí dentro; el hueco se reserva desde el principio para que
+   el botón no cambie de ancho al dibujarla y el renglón no brinque. */
+.ver-cot-ico { display: inline-flex; align-items: center; width: 0; transition: width .18s var(--ease-out); }
+.ver-cot-si[aria-pressed="true"] .ver-cot-ico { width: 1.2em; }
+.ver-cot-ico .palomita { width: 1.1em; height: 1.1em; }
+
+.ver-cotejo-fin {
+  margin: var(--e4) 0 0; padding: var(--e3);
+  color: var(--ok); font-weight: 600;
+  background: var(--ok-bg); border: 1px solid var(--ok-borde); border-radius: var(--rr3);
+}
+.ver-alterado {
+  margin-top: var(--e4); padding: var(--e4);
+  background: var(--mal-bg); border: 1px solid var(--mal-borde); border-radius: var(--rr3);
+}
+.ver-alterado h2 { margin: 0 0 var(--e2); font-size: var(--t4); color: var(--mal); }
+.ver-alterado p { color: var(--tinta); }
+.ver-alterado p:last-child { margin-bottom: 0; }
+
+/* ── A1 · El formulario que se pliega y el código en casillas ──
+   Plegado cuando ya hubo respuesta por QR. El <summary> mide 48 px de alto y lleva su flecha,
+   porque es lo único que se toca cuando la página llega con resultado. */
+.ver-form-caja {
+  border: 1px solid var(--linea); border-radius: var(--rr4);
+  background: var(--n0); margin: var(--e5) 0;
+}
+.ver-form-caja > summary {
+  display: flex; align-items: center; justify-content: space-between; gap: var(--e3);
+  min-height: 48px; padding: 0 var(--e5);
+  font-family: var(--f-cifra); font-size: var(--t5); font-weight: 600;
+  color: var(--tinta); cursor: pointer; list-style: none;
+  border-radius: var(--rr4);
+}
+.ver-form-caja > summary::-webkit-details-marker { display: none; }
+.ver-form-caja > summary:focus-visible { outline: 2px solid var(--a); outline-offset: 2px; }
+.ver-form { padding: 0 var(--e5) var(--e5); }
+.ver-form-ayuda, .ver-ayuda { font-size: var(--t2); color: var(--tinta2); }
+.ver-ayuda { margin: var(--e1) 0 0; }
+.ver-form-ayuda { margin: 0 0 var(--e4); }
+/* El campo del folio: en mayúsculas y con la cifra de la marca, porque lo que se teclea aquí
+   se está copiando carácter por carácter de un papel. */
+.ver-form #f-f { font-family: var(--f-cifra); letter-spacing: .04em; text-transform: uppercase; }
+.ver-form .casillas { margin-top: var(--e1); }
+/* Si js/piezas.js no cargara, lo que queda es el <input> del HTML tal cual, con la regla de
+   arriba: en la cifra de la marca y en mayúsculas, porque se está copiando de un papel. */
+.ver-form #f-c:not(.casillas-in) { font-family: var(--f-cifra); letter-spacing: .08em; text-transform: uppercase; }
+
+/* ── A19 · El índice de las páginas legales ──
+   En el teléfono, plegado en «En esta página»: nueve o diez renglones abiertos encima del
+   texto son media pantalla de nada antes de empezar a leer. De 1000 px para arriba se abre
+   solo y se va a una columna al lado, pegada al scroll.
+
+   Se pliega el ÍNDICE, nunca el texto: una política de privacidad con secciones cerradas es
+   una política que no se leyó. */
+.pub-indice {
+  margin: 0 0 var(--e5);
+  border: 1px solid var(--linea); border-radius: var(--rr4);
+  background: var(--n0);
+}
+.pub-indice > summary {
+  display: flex; align-items: center; justify-content: space-between; gap: var(--e3);
+  min-height: 48px; padding: 0 var(--e4);
+  font-size: var(--t2); font-weight: 600; text-transform: uppercase; letter-spacing: .06em;
+  color: var(--tinta2); cursor: pointer; list-style: none; border-radius: var(--rr4);
+}
+.pub-indice > summary::-webkit-details-marker { display: none; }
+.pub-indice > summary:focus-visible { outline: 2px solid var(--a); outline-offset: 2px; }
+.pub-indice-flecha { flex: none; transition: transform .2s var(--ease-out); }
+.pub-indice[open] > summary .pub-indice-flecha { transform: rotate(180deg); }
+.pub-indice ol { margin: 0; padding: 0 var(--e4) var(--e3); list-style: none; counter-reset: idx; }
+.pub-indice li { margin: 0; counter-increment: idx; }
+.pub-indice a {
+  display: flex; align-items: center; gap: var(--e2);
+  min-height: 44px; padding: 2px 0;
+  font-size: var(--t3); color: var(--tinta2); text-decoration: none;
+}
+.pub-indice a::before {
+  content: counter(idx); flex: none; min-width: 1.4em;
+  font-family: var(--f-cifra); font-variant-numeric: tabular-nums;
+  font-size: var(--t2); color: var(--tinta3); text-align: right;
+}
+@media (hover: hover) and (pointer: fine) { .pub-indice a:hover { color: var(--a-tx); } }
+.pub-indice a:focus-visible { outline: 2px solid var(--a); outline-offset: 2px; border-radius: var(--rr1); }
+
+/* El salto a una sección: el título se despega de arriba —si no, queda pegado al filete— y
+   destella una vez con los keyframes que ya existen en css/sistema.css. Es `:target`, o sea
+   CSS puro: ni un `scrollIntoView`, que dentro de un contenedor con scroll pelea con el
+   scroll del documento y deja el título a media pantalla. */
+.pub-doc h2 { scroll-margin-top: var(--e6); }
+.pub-doc h2:target { animation: scFlash 1.5s ease-out 1; }
+
+@media (min-width: 1000px) {
+  /* El documento y su índice, lado a lado. El texto se queda en su medida de lectura y el
+     índice ocupa la columna que sobra, pegado al scroll. */
+  .pub-doc .pub-wrap {
+    max-width: 1020px;
+    display: grid;
+    grid-template-columns: 1fr 15rem;
+    grid-template-areas: 'texto indice';
+    gap: 0 var(--e7);
+    align-items: start;
+  }
+  .pub-doc .pub-wrap > * { grid-area: texto; min-width: 0; }
+  .pub-doc .pub-indice {
+    grid-area: indice;
+    position: sticky; top: var(--e6);
+    margin: 0;
+  }
+  /* Abierto de oficio y sin su botón: en una columna al lado no hay nada que plegar. Va
+     dentro de un @supports porque lo que abre el <details> sin tocarlo es `::details-content`
+     (Chrome 131 y arriba); donde no exista, el índice se queda plegado con su «En esta
+     página», que es exactamente lo que hace en el teléfono y no se rompe nada. */
+  @supports selector(::details-content) {
+    .pub-doc .pub-indice > summary { display: none; }
+    .pub-doc .pub-indice::details-content { block-size: auto; content-visibility: visible; }
+    .pub-doc .pub-indice ol { padding-top: var(--e3); }
+  }
+}
+
+/* ── A26 · El filete de marca como progreso de lectura ──
+   El filete de 3 px de `body::before` es lo único de la marca que se ve siempre. En un
+   documento de diez secciones no decía nada; ahora dice cuánto llevas leído.
+
+   Cero JavaScript: es una animación ligada al scroll del documento (`animation-timeline`).
+   Va toda dentro de un @supports y sobre un elemento propio, y por eso no hace falta tocar
+   css/sistema.css: donde el navegador no la conozca, este elemento no se pinta y el filete
+   de siempre se queda entero, que es la degradación correcta.
+
+   La parte todavía no leída va en `--a-suave` y no en transparente: al 0 % la marca tiene que
+   seguir ahí, y un filete que desaparece al abrir la página se lee como que algo falló. */
+.pub-avance { display: none; }
+@supports (animation-timeline: scroll(root)) {
+  .pub-doc::before { background: var(--a-suave); }
+  .pub-avance {
+    display: block;
+    position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0; height: 3px;
+    z-index: 201;                       /* justo encima del filete de body::before, que es 200 */
+    background: var(--a);
+    transform-origin: left center; transform: scaleX(0);
+    pointer-events: none;
+    animation: pub-avance linear both;
+    animation-timeline: scroll(root);
+  }
+  @keyframes pub-avance { to { transform: scaleX(1); } }
+}
+/* Con menos movimiento NO se apaga: un relleno de avance es información, no adorno, y la
+   regla del sistema de diseño lo dice con esas palabras. Además no se mueve solo —se mueve
+   porque alguien está bajando con el dedo—, que es justo lo que `prefers-reduced-motion`
+   pide. En papel no existe: no hay scroll que seguir. */
+@media print { .pub-avance { display: none; } }
+
+/* ── A28 · «Qué hace», en cuatro tarjetas ──
+   2 x 2, una columna bajo 480 px. Quietas: ni hover ni entrada. En el teléfono el hover no
+   existe, y esta es una página que se abre una vez, se lee y se cierra. */
+.pub-tarjetas {
+  list-style: none; margin: 0 0 var(--e5); padding: 0;
+  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e3);
+}
+.pub-tarjeta {
+  margin: 0; padding: var(--e4);
+  background: var(--n0); border: 1px solid var(--linea); border-radius: var(--rr4);
+  color: var(--tinta2); font-size: var(--t3); line-height: 1.55;
+}
+.pub-dibujo { display: block; width: 64px; height: 40px; margin-bottom: var(--e3); overflow: visible; }
+/* Las cuatro ilustraciones, con las piezas del propio sistema. Los azules del acento para lo
+   que la app hace y los neutros para el soporte —la lámina, el eje—; nada lleva texto encima,
+   así que ninguno tiene que aguantar 4.5:1. */
+.pd-cara  { fill: var(--a); }
+.pd-canto { fill: var(--a-claro); }
+.pd-linea, .pd-eje { fill: none; stroke: var(--linea); stroke-width: 2.5; stroke-linecap: round; }
+.pd-curva { fill: none; stroke: var(--a); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
+.pd-punto { fill: var(--n0); stroke: var(--linea); stroke-width: 2.5; }
+.pd-punto.pd-hecho { fill: var(--a); stroke: var(--a); }
+.pd-hoja  { fill: none; stroke: var(--linea); stroke-width: 2; }
+.pd-pieza { fill: var(--a-suave); stroke: var(--a); stroke-width: 1.6; }
+@media (max-width: 480px) { .pub-tarjetas { grid-template-columns: 1fr; } }
+
+/* ── A20 · Créditos y licencias ──
+   Un renglón por pieza, con su licencia y a qué archivo del repo ir por el texto completo.
+   Tres de estas licencias piden la atribución por escrito; esta lista es la atribución. */
+.pub-creditos { list-style: none; margin: 0 0 var(--e4); padding: 0; }
+.pub-creditos li {
+  margin: 0 0 var(--e3); padding: 0 0 var(--e3);
+  border-bottom: 1px solid var(--linea);
+  font-size: var(--t3);
+}
+.pub-creditos li:last-child { border-bottom: 0; }
+.pub-lic { display: block; margin-top: var(--e1); font-size: var(--t2); color: var(--tinta3); }
+.pub-creditos code { font-size: .92em; overflow-wrap: anywhere; }
+/* El subrayado que crece desde la izquierda, con `background-size` y no con `border-bottom`:
+   así se puede animar sin mover una sola caja. Solo con puntero fino y con el foco: en el
+   teléfono no hay nada que recorrer con el ratón, y ahí el enlace se queda subrayado fijo. */
+.pub-creditos a {
+  text-decoration: none; font-weight: 600;
+  background-image: linear-gradient(currentColor, currentColor);
+  background-repeat: no-repeat; background-position: 0 100%; background-size: 100% 1px;
+}
+@media (hover: hover) and (pointer: fine) {
+  .pub-creditos a { background-size: 0 1px; transition: background-size .22s var(--ease-out); }
+  .pub-creditos a:hover, .pub-creditos a:focus-visible { background-size: 100% 1px; }
+}
+
+/* ══════════════ rm · publicas ══════════════
+   Menos movimiento: se apaga el adorno y se queda la información.
+
+   Lo que se va: el fundido del título, el destello del salto a una sección, el crecer del
+   subrayado, el encogerse al presionar y el encendido del neón de «acerca».
+   Lo que se queda: el avance de lectura (es información, y además solo se mueve porque
+   alguien está bajando con el dedo), el filete verde y la palomita de A14, y el glifo del
+   veredicto, que aparece ya dibujado. La carga de A23 y las casillas de A1 traen su propio
+   apagado en css/sistema.css. */
+@media (prefers-reduced-motion: reduce) {
+  .ver-titulo-cambia { animation: none; }
+  .ver-reng, .ver-cot, .ver-cot-ico { transition: none; }
+  .ver-cot:active { transform: none; }
+  .pub-doc h2:target { animation: none; }
+  .pub-indice-flecha { transition: none; }
+  .pub-creditos a { transition: none; background-size: 100% 1px; }
+  /* El neón del título de «acerca» es adorno puro: se queda el título, sin encenderse. */
+  .neon-texto.neon-al-cargar::after { animation: none; }
+  .neon-texto.neon-al-cargar.neon-queda::after { animation: none; opacity: 1; }
+}
+
+/* ── fin de publicas ── */
