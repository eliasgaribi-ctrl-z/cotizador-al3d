+.pf-tab .cta.sube,.pf-abajo .cta.sube{animation:none}
+.pf-abajo .cta.sube{transform:translate(14px,-9px)}
+html[data-va="adelante"] .pf-mod,html[data-va="atras"] .pf-mod{animation:none}
+/* La banda sigue apareciendo —es información, no adorno— pero sin desplegarse, y el scroll se
