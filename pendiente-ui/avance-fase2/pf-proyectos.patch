+
+  /* Y la cuenta «En el taller» del Tablero, por su clase y sin tocar tablero.js. */
+  await p.evaluate(() => document.querySelector('[data-cerrar-ficha]').click());
+  await p.waitForTimeout(500);
+  await irA(p, '#/tablero', 1600);
+  const taller = await borroso('.pf-cuenta.dinero');
+  taller === 'no existe'
+    ? bien('(en este tablero no hay cuenta «En el taller» que tapar)')
+    : (/blur/.test(taller) ? bien('la cuenta «En el taller» del Tablero también queda tapada')
+                           : mal('la cuenta «En el taller» sigue a la vista: ' + taller));
+
+  errs.length ? mal('errores de página: ' + [...new Set(errs)].slice(0, 2).join(' | ')) : bien('cero errores');
+  await ctx.close();
+}
+
+// ── 6. P9 · arrastrar entre columnas, con ratón y con teclado ─────────────
+console.log('\nP9 · LA TARJETA CAMBIA DE COLUMNA CON EL DEDO Y CON EL TECLADO');
+{
+  const { ctx, p, errs } = await abrir({ ancho: 1280 });
+  await irA(p, '#/hoy');
+  const hechos = await sembrar(p);
+  await irA(p, '#/proyectos', 1700);
+
+  (await p.$('.pj-tablero')) ? bien('a 1280 px hay tablero de columnas')
+                             : mal('no se pintó el tablero');
+  const ganado = hechos.find(h => h.etapa === 'ganado');
+  const donde = id => p.evaluate(i => {
+    const t = document.querySelector('[data-abrir="' + i + '"]');
+    const c = t && t.closest('.pj-col');
+    return c ? c.dataset.col : null;
+  }, id);
+  (await donde(ganado.id)) === 'ganado' ? bien('y la tarjeta arranca en su columna')
+                                        : mal('la tarjeta no está donde debería');
+
+  /* Un toque CORTO sigue abriendo la ficha: es lo primero que rompe meter un arrastre. */
+  const caja = await p.evaluate(i => {
+    const r = document.querySelector('[data-abrir="' + i + '"]').getBoundingClientRect();
+    return { x: r.x + r.width / 2, y: r.y + 16 };
+  }, ganado.id);
+  await p.mouse.move(caja.x, caja.y);
+  await p.mouse.down();
+  await p.waitForTimeout(90);
+  await p.mouse.up();
+  await p.waitForTimeout(900);
+  (await p.$eval('#pf-ficha', e => e.classList.contains('show')))
+    ? bien('un toque corto sigue abriendo la ficha')
+    : mal('el toque corto dejó de abrir la ficha');
+  await p.evaluate(() => document.querySelector('[data-cerrar-ficha]').click());
+  await p.waitForTimeout(700);
+
+  /* Mantener 250 ms levanta la tarjeta; soltarla en otra columna la mueve (pasando por la
+     pregunta del corte cuando toca). */
+  const destino = await p.evaluate(() => {
+    const c = document.querySelector('.pj-col[data-col="en_diseno"]');
+    const r = c.getBoundingClientRect();
+    return { x: r.x + r.width / 2, y: r.y + r.height - 30 };
+  });
+  await p.mouse.move(caja.x, caja.y);
+  await p.mouse.down();
+  await p.waitForTimeout(400);
+  (await p.$('.pj-fantasma')) ? bien('mantener 250 ms levanta la tarjeta, con su fantasma')
+                              : mal('la tarjeta no se levantó a los 250 ms');
+  await p.mouse.move(destino.x, destino.y, { steps: 12 });
+  await p.waitForTimeout(200);
+  (await p.$eval('.pj-col[data-col="en_diseno"]', e => e.classList.contains('sobre')))
+    ? bien('y la columna de debajo se ilumina')
+    : mal('la columna de destino no se iluminó');
+  await p.mouse.up();
+  await p.waitForTimeout(1400);
+  (await donde(ganado.id)) === 'en_diseno'
+    ? bien('al soltar, la tarjeta se queda en su columna nueva')
+    : mal('la tarjeta no cambió de columna: quedó en ' + await donde(ganado.id));
+  (await p.$('.pj-fantasma')) ? mal('el fantasma se quedó flotando') : bien('y el fantasma se va');
+
+  /* Cruzar «Cortado» PREGUNTA, igual que el Tablero: saca material del almacén. */
+  await p.evaluate(i => {
+    const t = document.querySelector('[data-abrir="' + i + '"]');
+    t.focus();
+  }, ganado.id);
+  await p.keyboard.down('Alt');
+  await p.keyboard.press('ArrowRight');
+  await p.keyboard.up('Alt');
+  await p.waitForTimeout(1000);
+  const pregunta = await p.$eval('#pf-confirma', e => e.classList.contains('show')).catch(() => false);
+  pregunta ? bien('Alt+→ mueve con el teclado, y cruzar «Cortado» pregunta antes (como el Tablero)')
+           : mal('Alt+→ no movió la tarjeta o no preguntó al cruzar «Cortado»');
+  if (pregunta) {
+    await p.evaluate(() => document.querySelector('#pf-confirma [data-conf="si"]').click());
+    await p.waitForTimeout(1300);
+    (await donde(ganado.id)) === 'cortado'
+      ? bien('y contestando que sí, la tarjeta llega a «Cortado»')
+      : mal('tras confirmar, la tarjeta quedó en ' + await donde(ganado.id));
+  }
+
+  errs.length ? mal('errores de página: ' + [...new Set(errs)].slice(0, 2).join(' | ')) : bien('cero errores');
+  await ctx.close();
+}
+
+// ── 7. P18 y P11 · lo que NO se mueve ─────────────────────────────────────
+console.log('\nP18 · LAS CUENTAS NO RUEDAN AL ENTRAR · P11 · «SIN DECIDIR» NO LATE EN BUCLE');
+{
+  const { ctx, p, errs } = await abrir({ ancho: 360 });
+  await irA(p, '#/hoy');
+  await sembrar(p);
+  await irA(p, '#/proyectos', 700);
+  /* Entrar no es un cambio. Si rodara al montar, habría cuatro odómetros corriendo en la
+     primera décima de segundo de la pantalla. */
+  const rodando = await p.$$eval('.pf-cuenta b', els => els.filter(e => e.classList.contains('rueda-rodando')).length);
+  rodando === 0 ? bien('al entrar, ninguna cuenta rueda')
+                : mal(rodando + ' cuenta(s) rodaron nada más entrar');
+  await p.waitForTimeout(1200);
+  const conMemoria = await p.$$eval('.pf-cuenta b[data-cuenta]', els => els.length);
+  conMemoria > 0 ? bien('pero las cuentas llevan su clave, así que un cambio SÍ rueda (' + conMemoria + ')')
+                 : mal('las cuentas no quedaron preparadas para rodar');
+
+  /* El latido de la tarjeta de «sin decidir»: tres veces y se calla, y solo cuando sube. */
+  const late = await p.evaluate(() => {
+    const el = document.querySelector('.cand-partidas');
+    if (!el) return 'no hay tarjeta';
+    const cs = getComputedStyle(el);
+    return cs.animationName + ' · ' + cs.animationIterationCount;
+  });
+  late === 'no hay tarjeta' || !/infinite/.test(late)
+    ? bien('el latido de «sin decidir» no es infinito: ' + late)
+    : mal('«sin decidir» late en bucle: ' + late);
+
+  errs.length ? mal('errores de página: ' + [...new Set(errs)].slice(0, 2).join(' | ')) : bien('cero errores');
+  await ctx.close();
+}
+
+// ── 8. Fabricación no ve el dinero, ni el interruptor ─────────────────────
+console.log('\nFABRICACIÓN NO VE NINGUNA DE ESTAS CIFRAS');
+{
+  const { ctx, p, errs } = await abrir({ ancho: 360, rol: 'fabricacion' });
+  await irA(p, '#/hoy');
+  const hechos = await sembrar(p);
+  await irA(p, '#/proyectos', 1600);
+  (await p.$$('[data-cliente]')).length === 0
+    ? bien('sin dinero en pantalla, el interruptor de modo cliente no sale')
+    : mal('fabricación ve el interruptor de un modo que no tapa nada suyo');
+  const inst = hechos.find(h => h.etapa === 'instalado');
+  await p.evaluate(id => { const b = document.querySelector('[data-abrir="' + id + '"]'); if (b) b.click(); }, inst.id);
+  await p.waitForTimeout(900);
+  (await p.$$('.pf-interno')).length === 0 && (await p.$$('.pj-liq')).length === 0
+    ? bien('y en la ficha no se pinta ni la comisión ni la liquidación: no hay nada que difuminar')
+    : mal('fabricación ve dinero en la ficha');
+  (await p.$('.pj-gar'))
+    ? bien('la garantía sí la ve: la necesita en la calle y no lleva un peso encima')
+    : mal('fabricación no ve la garantía, que es lo único de este bloque que sí le toca');
+  errs.length ? mal('errores de página: ' + [...new Set(errs)].slice(0, 2).join(' | ')) : bien('cero errores');
+  await ctx.close();
+}
+
+console.log(fallos ? '\n' + fallos + ' FALLO(S)' : '\nProyectos aguanta el dedo, el ratón y el teclado, en claro y en oscuro, sin moverse sola.');
+await nav.close();
+process.exit(fallos ? 1 : 0);
diff --git a/pruebas/pf-proyectos-garantia.mjs b/pruebas/pf-proyectos-garantia.mjs
