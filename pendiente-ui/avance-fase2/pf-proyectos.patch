+.pj-liq b{display:block;font-size:var(--t3);line-height:1.3}
+.pj-liq small{display:block;margin-top:2px;font-size:var(--t1);font-weight:600;color:inherit;line-height:1.4}
+.pj-liq .marca-estado{flex:none;margin-top:1px}
+
+/* Las dos garantías. El medidor es el de la pieza 20: una barra quieta, sin transición y sin
