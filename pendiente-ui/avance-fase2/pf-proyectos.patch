+      const inf = await infinitas(p);
+      inf.length === 0 ? bien(que + ': nada se anima en bucle en reposo')
+                       : mal(que + ': animación infinita en ' + inf.join(', '));
+      /* Y con la ficha abierta, que es donde vive casi todo lo nuevo. */
+      await p.evaluate(() => document.querySelector('[data-abrir]').click());
+      await p.waitForTimeout(900);
+      const dx2 = await desborde(p);
+      dx2 <= 1 ? bien(que + ': la ficha tampoco desborda') : mal(que + ': la ficha desborda ' + dx2 + ' px');
+      const inf2 = await infinitas(p);
+      inf2.length === 0 ? bien(que + ': ni la ficha se anima en bucle')
+                        : mal(que + ': la ficha anima en bucle ' + inf2.join(', '));
+      errs.length ? mal(que + ': errores de página: ' + [...new Set(errs)].slice(0, 2).join(' | '))
+                  : bien(que + ': cero errores de página');
+      await ctx.close();
+    }
+  }
+}
+
+// ── 2. P28 · las columnas como páginas, y la tira que las pasa ─────────────
+console.log('\nP28 · EN EL TELÉFONO, LAS COLUMNAS SON PÁGINAS');
+{
+  const { ctx, p, errs } = await abrir({ ancho: 360 });
