+/* PROYECTOS: LA FICHA, LA ETAPA COMO PASOS, EL MODO CLIENTE Y LA GARANTÍA.
+ *
+ * Esta pantalla es la que se abre delante del cliente, en un teléfono de gama media, a las
+ * siete de la tarde. Lo que defiende este archivo es exactamente eso:
+ *
+ *   · P2  · guardar una cuenta no tira el panel arriba ni pierde el foco, y el chip lo dice;
+ *   · P7  · la etapa se lee como pasos —qué pasó, en qué va— y el botón dice lo que sigue;
+ *   · P9  · una tarjeta se arrastra de columna con el ratón, y con Alt+→/← con teclado, y un
+ *           toque corto sigue abriendo la ficha (que es lo que se rompe al meter un arrastre);
+ *   · P11 · la tarjeta de «sin decidir» no late en bucle;
+ *   · P12 · el modo cliente tapa la comisión y NO el total del proyecto, y se destapa mientras
+ *           dura el dedo;
+ *   · P18 · las cuentas no ruedan al ENTRAR a la pantalla;
+ *   · P28 · en el teléfono las columnas son páginas que se deslizan, sincronizadas con la tira;
+ *   · 53  · la ficha de un instalado dice cuántos días hábiles quedan para liquidar y hasta
+ *           cuándo va cada garantía;
+ *   y en todas las medidas: 360 y 420 px, claro y oscuro, con y sin movimiento reducido, sin
+ *   errores de página, sin desborde horizontal y sin nada animándose en bucle en reposo.
+ *
+ * Uso:  PUERTO=8923 node pruebas/navegador/pf-proyectos.mjs
+ */
+
+import { chromium } from '/opt/node22/lib/node_modules/playwright/index.mjs';
+
+const B = 'http://127.0.0.1:' + (process.env.PUERTO || '8814');
+const nav = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium-1194/chrome-linux/chrome' });
+
+let fallos = 0;
+const mal = m => { console.log('  ✗ ' + m); fallos++; };
+const bien = m => console.log('  ✓ ' + m);
+
+/* Dirección y con nombre: es el rol que ve el dinero, los estatus de la hoja y «No se dio», y
+   sin nombre Ajustes pondría su presentación delante. */
+const sesion = (tema = 'claro') => `
+  try {
+    localStorage.setItem('al3d_pf_rol', 'direccion');
+    localStorage.setItem('al3d_pf_nombre', 'Beto');
+    localStorage.setItem('al3d_pf_ult_export', new Date().toISOString());
+    localStorage.setItem('al3d_tema', '${tema}');
+  } catch (_) {}
+`;
+
+async function abrir({ ancho = 360, tema = 'claro', rm = false, rol = 'direccion' } = {}) {
+  const ctx = await nav.newContext({
+    viewport: { width: ancho, height: 780 }, locale: 'es-MX',
+    timezoneId: 'America/Mexico_City', serviceWorkers: 'block',
+    deviceScaleFactor: 2,
+    ...(rm ? { reducedMotion: 'reduce' } : {}),
+  });
+  await ctx.addInitScript(new Function(sesion(tema).replace("'direccion'", `'${rol}'`)));
+  const p = await ctx.newPage();
+  const errs = [];
+  p.on('pageerror', e => errs.push(e.message));
+  return { ctx, p, errs };
+}
+
+/* Los proyectos se crean por la CAPA DE DATOS, como en las demás pruebas de navegador: `ganar()`
+   es lo que de verdad crea un proyecto, con su origen congelado y su material derivado. */
+async function sembrar(p, { conInstalacion = true } = {}) {
+  return p.evaluate(async (hayInst) => {
+    const Proy = await import('./js/datos/proyectos.js');
+    const Agenda = await import('./js/datos/agenda.js');
+    const letras = { id: 1, tipo: 'letras', material: 'acero', comp: 'recta', luz: true, altura: 40, n: 8 };
+    const hechos = [];
+    const filas = [
+      ['COT-8801', 'Healthylicious', 'ganado', 17004],
+      ['COT-8802', 'La Perla', 'en_diseno', 24000],
+      ['COT-8803', 'Gym Titanio', 'cortado', 69400],
+      ['COT-8804', 'Dental Sonrisa', 'instalado', 17004],
+    ];
+    for (const [folio, cliente, etapa, neto] of filas) {
+      const r = await Proy.ganar({ folio, cliente, proy: cliente + ' — anuncio', ts: Date.now(),
+        estado: 'autorizada', items: [letras], neto, itemsAuth: { 1: neto } },
+        { pct_comision: 10 });
+      if (!r.ok) continue;
+      const id = r.valor.id;
+      if (etapa !== 'ganado') await Proy.avanzarEtapa(id, etapa);
+      if (hayInst) {
+        /* Una instalación de hace cinco días para el instalado: así la cuenta regresiva de la
+           liquidación ya venció y la garantía lleva algo consumido. */
+        const hoy = new Date();
+        const d = new Date(hoy.getTime() - (etapa === 'instalado' ? 5 : -7) * 86400000);
+        const iso = d.toISOString().slice(0, 10);
+        await Agenda.agendar({ proyecto_id: id, fecha: iso, hora: '10:00' });
+      }
+      hechos.push({ id, etapa, cliente });
+    }
+    return hechos;
+  }, conInstalacion);
+}
+
+const irA = async (p, hash, espera = 1400) => {
+  const destino = B + '/' + hash;
+  if (p.url() === destino) await p.reload({ waitUntil: 'load' });
+  else await p.goto(destino, { waitUntil: 'load' });
+  await p.waitForTimeout(espera);
+};
+
+/* Lo que se comprueba en TODAS las medidas: sin desborde, sin errores y sin nada girando solo.
+   El botón de «Cotizar con IA» es la única pieza que la regla del sistema deja moverse sola, y
+   vive en el cotizador: en la plataforma la lista tiene que quedar vacía. */
+const infinitas = p => p.evaluate(() => document.getAnimations()
+  .filter(a => { try { return a.effect.getComputedTiming().iterations === Infinity; } catch (_) { return false; } })
+  .map(a => { const t = a.effect && a.effect.target; return (t && (t.id || t.className)) || a.animationName || '?'; }));
+const desborde = p => p.evaluate(() =>
+  document.documentElement.scrollWidth - document.documentElement.clientWidth);
+
+// ── 1. La pantalla, en las cuatro combinaciones ────────────────────────────
+console.log('\nLA PANTALLA AGUANTA LAS CUATRO COMBINACIONES');
+for (const ancho of [360, 420]) {
+  for (const tema of ['claro', 'oscuro']) {
+    for (const rm of [false, true]) {
+      const { ctx, p, errs } = await abrir({ ancho, tema, rm });
