+
+  const pags = await p.$$eval('.pj-pag', els => els.map(e => e.dataset.col));
+  pags.length >= 4 ? bien('hay una página por etapa con proyectos: ' + pags.join(', '))
+                   : mal('solo ' + pags.length + ' página(s): ' + pags.join(', '));
+  (await p.$eval('.pj-lista-movil', e => e.classList.contains('paginas')))
+    ? bien('la tira es el carrusel de la pieza (scroll-snap y teclado incluidos)')
+    : mal('la lista del teléfono no quedó como páginas');
